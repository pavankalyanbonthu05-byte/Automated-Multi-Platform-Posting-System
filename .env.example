# ==========================================
# Automated Multi-Platform Posting System
# Configuration & Credentials
# ==========================================

# Execution Mode:
# When DRY_RUN_MODE=true, any platform without live credentials will execute a simulated API call,
# demonstrating end-to-end integration flow without throwing authentication/network errors.
# Set to false to strictly require live API tokens and make real API calls.
DRY_RUN_MODE=true

# Server Configuration
PORT=4000
HOST=0.0.0.0

# Platform 1: Telegram Channel / Supergroup Bot
# Create a bot via @BotFather to get the token, and add it as admin to your channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Platform 2: Discord Webhook
# Create a webhook under Server Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=

# Platform 3: Slack Incoming Webhook
# Create an Incoming Webhook via api.slack.com/apps
SLACK_WEBHOOK_URL=

# Platform 4: Mastodon / Decentralized Social Web
# Generate an access token under Preferences -> Development -> New Application
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Platform 5: Dev.to (Forem Developer Community)
# Generate an API key under Settings -> Extensions -> DEV Community API Keys
DEVTO_API_KEY=
